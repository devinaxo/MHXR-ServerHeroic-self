# Server
# IP: bind address (0.0.0.0 = all interfaces)
# WEB_URL/RES_URL: must be reachable by the game client (use your LAN IP, not localhost)
IP=0.0.0.0
PORT=80
WEB_URL=http://192.168.1.100/web
RES_URL=http://192.168.1.100/

# MongoDB
DB_IP=127.0.0.1
DB_PORT=27017
DB_NAME=apypos
DB_USER=root
DB_PASSWORD=example

# Maintenance
API_NOT_AVAILABLE_MAINTENANCE=false
IS_MAINTENANCE=false

# Debug (logs full request/response bodies when true)
DEBUG=false
ENABLE_VALIDATION=false

# Palico (otomo) tuning. See docs/OTOMO-PALICO.md.
# Percent chance that an island quest leaves a new Palico (0 disables it).
#OTOMO_ENCOUNTER_CHANCE=20
# End-of-quest exp for the Palicos that set off (fixed number or min-max).
#OTOMO_QUEST_EXP=10000-100000
# 0 disables teaching a subskill when a level-up opens a slot.
#OTOMO_SKILL_ON_LEVELUP=1

# SSL/TLS (only used when PORT=443)
# SSL_KEY_PATH=/etc/ssl/private/private.key
# SSL_CERT_PATH=/etc/ssl/certs/certificate.crt
# SSL_CA_PATH=/etc/ssl/certs/ca.crt
